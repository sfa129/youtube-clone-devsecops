
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        DOCKER_IMAGE = 'mydockerpersonalwork/youtube-clone'
        DOCKER_CREDENTIALS = 'jenkins-dockerhub'
        SONAR_SERVER = 'Sonarqube_server'
        SONAR_SCANNER = 'SonarQube_scanner'
        SONAR_PROJECT_KEY = 'Jen-Sonar-FirstProject'
        KUBECONFIG_PATH = '/var/lib/jenkins/virtualtechbox-kubeconfig'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/sfa129/youtube-clone-devsecops.git'

                sh '''
                    echo "Source code checked out successfully"
                    git rev-parse --short HEAD
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool "${SONAR_SCANNER}"

                    withSonarQubeEnv("${SONAR_SERVER}") {
                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                              -Dsonar.projectName=Jen-Sonar-FirstProject \
                              -Dsonar.projectKey=Jen-Sonar-FirstProject
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    script {
                        def qualityGate = waitForQualityGate()

                        echo "SonarQube Quality Gate: ${qualityGate.status}"

                        if (qualityGate.status != 'OK') {
                            echo 'Quality Gate did not pass. Review SonarQube findings.'
                        }
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('TRIVY FS SCAN') {
            steps {
                sh '''
                    trivy fs . > trivyfs.txt
                '''
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    withDockerRegistry(
                        credentialsId: "${DOCKER_CREDENTIALS}",
                        url: 'https://index.docker.io/v1/'
                    ) {
                        sh '''
                            docker build \
                              -t "$DOCKER_IMAGE:$BUILD_NUMBER" \
                              -t "$DOCKER_IMAGE:latest" .

                            docker push "$DOCKER_IMAGE:$BUILD_NUMBER"
                            docker push "$DOCKER_IMAGE:latest"
                        '''
                    }
                }
            }
        }

        stage('TRIVY Image Scan') {
            steps {
                sh '''
                    trivy image \
                      --format table \
                      --output trivyimage.txt \
                      "$DOCKER_IMAGE:$BUILD_NUMBER"
                '''
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    export KUBECONFIG="$KUBECONFIG_PATH"

                    kubectl apply -f Kubernetes/deployment.yml
                    kubectl apply -f Kubernetes/service.yml

                    kubectl set image deployment/youtube-clone-app \
                      youtube-clone-app="$DOCKER_IMAGE:$BUILD_NUMBER"

                    kubectl rollout status deployment/youtube-clone-app \
                      --timeout=180s

                    echo "---- Kubernetes Pods ----"
                    kubectl get pods -o wide

                    echo "---- Kubernetes Service ----"
                    kubectl get service youtube-clone-app
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'trivyfs.txt,trivyimage.txt',
                allowEmptyArchive: true
            )

            emailext(
                to: 'sfahmed129@gmail.com',
                subject: "Jenkins Build ${BUILD_NUMBER}: ${currentBuild.currentResult}",
                body: """
                    Hello,

                    Project: ${JOB_NAME}
                    Build Number: ${BUILD_NUMBER}
                    Build Status: ${currentBuild.currentResult}

                    Build Details: ${BUILD_URL}

                    Trivy filesystem and image scan reports are
                    attached when available.

                    Regards,
                    Jenkins
                """,
                attachLog: true,
                attachmentsPattern: 'trivyfs.txt,trivyimage.txt'
            )
        }

        cleanup {
            cleanWs()
        }
    }
}
